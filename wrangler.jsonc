{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sulc3d",
  "main": "worker.js",
  "compatibility_date": "2026-04-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // poptávky z formuláře → e-mail (Cloudflare Email Routing, adresa musí být ověřená)
  "send_email": [
    { "name": "MAIL", "destination_address": "samot.sulc@seznam.cz" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
